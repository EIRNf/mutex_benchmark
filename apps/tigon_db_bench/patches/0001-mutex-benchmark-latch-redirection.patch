diff --git a/common/SpinLock.h b/common/SpinLock.h
index ef356db..eccd7f6 100644
--- a/common/SpinLock.h
+++ b/common/SpinLock.h
@@ -6,11 +6,38 @@
 
 #include <atomic>
 #include <ostream>
+#include <pthread.h>
 
 namespace star
 {
 class SpinLock {
     public:
+#if defined(TIGON_USE_PTHREAD_MUTEX)
+	SpinLock()
+	{
+		pthread_mutex_init(&mutex_, nullptr);
+	}
+	~SpinLock()
+	{
+		pthread_mutex_destroy(&mutex_);
+	}
+
+	SpinLock(const SpinLock &) = delete;
+	SpinLock &operator=(const SpinLock &) = delete;
+
+	void lock()
+	{
+		pthread_mutex_lock(&mutex_);
+	}
+
+	void unlock()
+	{
+		pthread_mutex_unlock(&mutex_);
+	}
+
+    private:
+	pthread_mutex_t mutex_;
+#else
 	// constructors
 	SpinLock() = default;
 
@@ -34,5 +61,6 @@ class SpinLock {
 
     private:
 	std::atomic_flag lock_ = ATOMIC_FLAG_INIT;
+#endif
 };
 } // namespace star
diff --git a/common/tigon_latch.h b/common/tigon_latch.h
new file mode 100644
index 0000000..07a2ff6
--- /dev/null
+++ b/common/tigon_latch.h
@@ -0,0 +1,29 @@
+#pragma once
+
+#include <pthread.h>
+
+#if defined(TIGON_USE_PTHREAD_MUTEX)
+// Transparent redirection of pthread spinlocks to pthread mutexes.
+//
+// Motivation:
+// In glibc, sizeof(pthread_spinlock_t) == 4 bytes (a 32-bit integer).
+// The repo's preload interposer (preload/pthread_lock_shim.cpp) claims mutexes
+// in-place by overwriting their first 16 bytes with a ClaimedHeader (magic + ShimMutex*),
+// which requires pthread_mutex_t (40 bytes on glibc, 64 on macOS).
+//
+// By mapping pthread_spinlock_t -> pthread_mutex_t and routing pthread_spin_*
+// through pthread_mutex_*, all Tigon bucket and record latches become valid
+// pthread_mutex_t objects that the preload shim seamlessly claims and measures,
+// without altering any algorithmic code in Tigon.
+//
+// All latches are initialized with NULL attr (process-private) so that the
+// shim's PTHREAD_PROCESS_SHARED filter does not ignore them.
+
+#define pthread_spinlock_t pthread_mutex_t
+#define pthread_spin_init(lock, pshared) pthread_mutex_init((lock), nullptr)
+#define pthread_spin_destroy(lock) pthread_mutex_destroy((lock))
+#define pthread_spin_lock(lock) pthread_mutex_lock((lock))
+#define pthread_spin_trylock(lock) pthread_mutex_trylock((lock))
+#define pthread_spin_unlock(lock) pthread_mutex_unlock((lock))
+
+#endif // TIGON_USE_PTHREAD_MUTEX
